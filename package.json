{
  "name": "beehiiv-notion-sync",
  "version": "0.2.0",
  "description": "Sync Beehiiv subscribers and post analytics to Notion databases automatically",
  "main": "dist/index.js",
  "bin": {
    "beehiiv-notion-sync": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whybothercoding/beehiiv-notion-sync.git"
  },
  "bugs": {
    "url": "https://github.com/whybothercoding/beehiiv-notion-sync/issues"
  },
  "homepage": "https://github.com/whybothercoding/beehiiv-notion-sync#readme",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:badges": "istanbul-badges-readme --coverageDir=coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "beehiiv",
    "notion",
    "newsletter",
    "sync",
    "automation",
    "cli"
  ],
  "author": "Theo Lasha <contact@indiegoweb.com>",
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "axios": "^1.7.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "ora": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "istanbul-badges-readme": "^1.9.0",
    "jest": "^29.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.67.0"
  }
}
